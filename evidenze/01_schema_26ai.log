SQL> -- ASSET: asset censiti dall'organizzazione.
SQL> CREATE TABLE asset (
  2      id_asset          NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      id_organizzazione NUMBER(10) NOT NULL,
  4      nome_asset        VARCHAR2(150) NOT NULL,
  5      tipo_asset        VARCHAR2(80) NOT NULL,
  6      criticita         VARCHAR2(10) NOT NULL,
  7      stato             VARCHAR2(10) NOT NULL,
  8  
  9      CONSTRAINT pk_asset
 10          PRIMARY KEY (id_asset),
 11  
 12      CONSTRAINT fk_asset_organizzazione
 13          FOREIGN KEY (id_organizzazione)
 14          REFERENCES organizzazioni (id_organizzazione),
 15  
 16      CONSTRAINT ck_asset_criticita
 17          CHECK (criticita IN ('BASSA', 'MEDIA', 'ALTA', 'CRITICA')),
 18  
 19      CONSTRAINT ck_asset_stato
 20          CHECK (stato IN ('ATTIVO', 'INATTIVO', 'DISMESSO'))
 21  );

Table ASSET created.

