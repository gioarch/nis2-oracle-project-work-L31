SQL> -- ORGANIZZAZIONI: organizzazione utilizzata nel caso di studio.
SQL> CREATE TABLE organizzazioni (
  2      id_organizzazione   NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      nome_organizzazione VARCHAR2(150) NOT NULL,
  4  
  5      CONSTRAINT pk_organizzazioni
  6          PRIMARY KEY (id_organizzazione)
  7  );

