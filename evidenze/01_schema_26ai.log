SQL> -- STORICO_ASSET: versioni storiche degli asset.
SQL> CREATE TABLE storico_asset (
  2      id_storico_asset     NUMBER(10) GENERATED BY DEFAULT AS IDENTITY (START WITH 1000),
  3      id_asset             NUMBER(10) NOT NULL,
  4      numero_versione      NUMBER(10) NOT NULL,
  5      data_inizio_validita DATE NOT NULL,
  6      data_fine_validita   DATE,
  7      nome_asset           VARCHAR2(150) NOT NULL,
  8      tipo_asset           VARCHAR2(80) NOT NULL,
  9      criticita            VARCHAR2(10) NOT NULL,
 10      stato                VARCHAR2(10) NOT NULL,
 11      tipo_modifica        VARCHAR2(50) NOT NULL,
 12      descrizione_modifica VARCHAR2(500),
 13  
 14      CONSTRAINT pk_storico_asset
 15          PRIMARY KEY (id_storico_asset),
 16  
 17      CONSTRAINT fk_stasset_asset
 18          FOREIGN KEY (id_asset)
 19          REFERENCES asset (id_asset),
 20  
 21      CONSTRAINT uq_stasset_ver
 22          UNIQUE (id_asset, numero_versione),
 23  
 24      CONSTRAINT ck_stasset_ver
 25          CHECK (numero_versione > 0),
 26  
 27      CONSTRAINT ck_stasset_date
 28          CHECK (
 29              data_fine_validita IS NULL
 30              OR data_fine_validita >= data_inizio_validita
 31          ),
 32  
 33      CONSTRAINT ck_stasset_crit
 34          CHECK (criticita IN ('BASSA', 'MEDIA', 'ALTA', 'CRITICA')),
 35  
 36      CONSTRAINT ck_stasset_stato
 37          CHECK (stato IN ('ATTIVO', 'INATTIVO', 'DISMESSO'))
 38  );

Table STORICO_ASSET created.

