SQL> PROMPT === T08 - Cardinalita attese delle query Q1-Q9 ===
=== T08 - Cardinalita attese delle query Q1-Q9 ===
SQL> -- Riproduce le relazioni e i filtri utilizzati dalle query Q1-Q9
SQL> -- e confronta la cardinalita ottenuta con quella attesa per il dataset
SQL> -- dimostrativo. Gli ORDER BY non vengono ripetuti perche non modificano
SQL> -- il numero di righe restituito.
SQL> 
SQL> SELECT
  2      requisito,
  3      righe_rilevate,
  4      righe_attese,
  5      CASE
  6          WHEN righe_rilevate = righe_attese THEN 'OK'
  7          ELSE 'KO'
  8      END AS esito
  9  FROM (
 10      SELECT
 11          'Q1 asset critici' AS requisito,
 12          COUNT(*) AS righe_rilevate,
 13          3 AS righe_attese
 14      FROM asset a
 15      JOIN organizzazioni o
 16          ON o.id_organizzazione = a.id_organizzazione
 17      WHERE a.criticita = 'CRITICA'
 18  
 19      UNION ALL
 20  
 21      SELECT
 22          'Q2 servizi erogati',
 23          COUNT(*),
 24          5
 25      FROM servizi s
 26      JOIN organizzazioni o
 27          ON o.id_organizzazione = s.id_organizzazione
 28  
 29      UNION ALL
 30  
 31      SELECT
 32          'Q3 dipendenze da terze parti',
 33          COUNT(*),
 34          7
 35      FROM servizi_fornitori sf
 36      JOIN servizi s
 37          ON s.id_servizio = sf.id_servizio
 38      JOIN fornitori f
 39          ON f.id_fornitore = sf.id_fornitore
 40  
 41      UNION ALL
 42  
 43      SELECT
 44          'Q4 responsabili',
 45          COUNT(*),
 46          21
 47      FROM (
 48          SELECT
 49              r.id_responsabile,
 50              'ASSET' AS tipo_elemento,
 51              a.id_asset AS id_elemento
 52          FROM responsabili r
 53          JOIN asset_responsabili ar
 54              ON ar.id_responsabile = r.id_responsabile
 55          JOIN asset a
 56              ON a.id_asset = ar.id_asset
 57  
 58          UNION ALL
 59  
 60          SELECT
 61              r.id_responsabile,
 62              'SERVIZIO' AS tipo_elemento,
 63              s.id_servizio AS id_elemento
 64          FROM responsabili r
 65          JOIN servizi_responsabili sr
 66              ON sr.id_responsabile = r.id_responsabile
 67          JOIN servizi s
 68              ON s.id_servizio = sr.id_servizio
 69      )
 70  
 71      UNION ALL
 72  
 73      SELECT
 74          'Q5 punti di contatto',
 75          COUNT(*),
 76          31
 77      FROM (
 78          SELECT
 79              pc.id_punto_contatto,
 80              'ASSET' AS tipo_elemento,
 81              a.id_asset AS id_elemento
 82          FROM punti_contatto pc
 83          JOIN responsabili r
 84              ON r.id_responsabile = pc.id_responsabile
 85          JOIN asset_responsabili ar
 86              ON ar.id_responsabile = r.id_responsabile
 87          JOIN asset a
 88              ON a.id_asset = ar.id_asset
 89  
 90          UNION ALL
 91  
 92          SELECT
 93              pc.id_punto_contatto,
 94              'SERVIZIO' AS tipo_elemento,
 95              s.id_servizio AS id_elemento
 96          FROM punti_contatto pc
 97          JOIN responsabili r
 98              ON r.id_responsabile = pc.id_responsabile
 99          JOIN servizi_responsabili sr
100              ON sr.id_responsabile = r.id_responsabile
101          JOIN servizi s
102              ON s.id_servizio = sr.id_servizio
103      )
104  
105      UNION ALL
106  
107      SELECT
108          'Q6 riepilogo servizio',
109          COUNT(*),
110          1
111      FROM servizi s
112      WHERE s.id_servizio = 1
113  
114      UNION ALL
115  
116      SELECT
117          'Q7 storico asset',
118          COUNT(*),
119          3
120      FROM storico_asset sa
121      WHERE sa.id_asset = 1
122  
123      UNION ALL
124  
125      SELECT
126          'Q8 storico servizi',
127          COUNT(*),
128          3
129      FROM storico_servizi ss
130      WHERE ss.id_servizio = 1
131  
132      UNION ALL
133  
134      SELECT
135          'Q9 dipendenze tecniche',
136          COUNT(*),
137          10
138      FROM dipendenze d
139      JOIN asset ao
140          ON ao.id_asset = d.id_asset_origine
141      JOIN asset ar
142          ON ar.id_asset = d.id_asset_richiesto
143  )
144  ORDER BY requisito;

