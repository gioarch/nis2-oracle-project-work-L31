SQL> -- Q4 - Responsabili associati ad asset e servizi
SQL> -- Le responsabilità su asset e servizi vengono riportate nello stesso risultato,
SQL> -- mantenendo indicato il tipo di elemento.
SQL> SELECT
  2      r.id_responsabile,
  3      r.nome || ' ' || r.cognome AS nominativo,
